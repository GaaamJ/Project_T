{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c9e402570301dfa1117e712947166088",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SpriteOutline (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -600,
            "y": 0,
            "width": 240,
            "height": 200
        }
    },
    "m_Slots": [
        {
            "m_Id": "57c10103ede407473bfb7cfc4c641a60"
        },
        {
            "m_Id": "92ba929e7a606411bb918ecac3e2f556"
        },
        {
            "m_Id": "7639cc62698423a1d37515894fa6b463"
        },
        {
            "m_Id": "8694a641b9a8c59e6d196cf73b6736fc"
        },
        {
            "m_Id": "b0806ebaa2bd68a26697686a43cbabd7"
        },
        {
            "m_Id": "ee8c7f3495c152ec8d1873ec6f4ca58c"
        },
        {
            "m_Id": "0fbfacdab57f01831ba10ed5e8363d22"
        },
        {
            "m_Id": "498978ca55c32b08cb459c2fb2435a8f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SpriteOutline",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 메시 밖은 그려지지 않으므로 외곽선이 보이려면 스프라이트가 Mesh Type Full Rect이고 두께 이상의 투명 여백이 있어야 한다.\nfloat4 texColor = SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV);\n// _TexelSize 프로퍼티를 쓰면 2D SRP Batcher가 꺼지므로 텍스처 크기를 직접 구한다.\nfloat width, height;\nTex.tex.GetDimensions(width, height);\nfloat2 d = Thickness / float2(width, height);\nfloat neighbor = 0;\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2( d.x, 0)).a);\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2(-d.x, 0)).a);\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2(0,  d.y)).a);\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2(0, -d.y)).a);\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2( d.x,  d.y)).a);\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2(-d.x,  d.y)).a);\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2( d.x, -d.y)).a);\nneighbor = max(neighbor, SAMPLE_TEXTURE2D(Tex.tex, Tex.samplerstate, UV + float2(-d.x, -d.y)).a);\nfloat outline = step(0.5, Enabled) * neighbor * (1 - texColor.a);\nfloat4 result = lerp(texColor * Tint, OutlineColor, outline);\nRGB = result.rgb;\nAlpha = result.a;"
}

