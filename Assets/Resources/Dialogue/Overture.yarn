title: Overture_Start
---
// 프롤로그 대사에서 사용하는 변수들.
// Yarn v3 컴파일러는 노드 밖 declare 를 허용하지 않으므로,
// 이 시작 노드의 첫 줄에 몰아 두어 실제로 쓰이는 흐름 바로 앞에 문서화한다.
// $pc_username : OvertureManager 가 Start() 시점에 Environment.UserName 을 주입.
// $in_game_name : NameInputView 가 확인 버튼/Enter 로 입력받은 값을 주입.
<<declare $pc_username = "" as string>>
<<declare $in_game_name = "" as string>>

